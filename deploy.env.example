# Скопируйте в deploy.env и скорректируйте при необходимости.
# Если файл deploy.env отсутствует, deploy.sh использует эти же defaults.

FRONTEND_PORT=15173
BACKEND_PORT=18000
APP_ENV=production
BITRIX_MODE=mock
SERVER_IP=auto
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api
DEBUG=false
DISK_WARN_MB=4096
DISK_MIN_MB=2048
RAM_WARN_MB=2048
AUTO_SWITCH_PORTS=false
